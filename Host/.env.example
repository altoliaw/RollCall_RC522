# Copy this file to `.env` (same directory) and edit the values that differ
# on your machine. `.env` is gitignored; this template is the tracked copy
# read by `rollcall_host/config.py`. Any key left out here falls back to the
# default hardcoded in `config.py`.

# Virtual COM port exposed by the paired HC-06 Bluetooth module.
# Windows: Control Panel > Devices and Printers > (device) > Bluetooth
# Services tab > "Outgoing" port. Linux: usually /dev/rfcomm0.
SERIAL_PORT=COM3

# Must match the USART3 baud rate configured in the STM32 firmware.
BAUD_RATE=9600

# Seconds to wait per serial read before the listener re-checks for shutdown.
SERIAL_TIMEOUT_SECONDS=1.0

# Seconds to wait before retrying a dropped/failed serial connection.
RECONNECT_DELAY_SECONDS=3.0

# Path to the SQLite database file.
DB_PATH=rollcall.db
